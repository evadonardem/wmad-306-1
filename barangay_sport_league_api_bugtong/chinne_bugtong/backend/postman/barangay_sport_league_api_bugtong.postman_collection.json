{
  "info": {
    "name": "Barangay Sport League API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1"},
    {"key": "token", "value": ""}
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{baseUrl}}/api/register",
            "body": {"mode": "raw", "raw": "{\"name\": \"Demo User\", \"email\": \"demo@example.com\", \"password\": \"password\"}"}
          }
        },
        {
          "name": "Login (sets token)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{baseUrl}}/api/login",
            "body": {"mode": "raw", "raw": "{\"email\": \"admin@example.com\", \"password\": \"password\"}"}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful', function() {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('token');",
                  "  pm.environment.set('token', json.data.token);",
                  "  console.log('Token set to: ' + json.data.token.substring(0, 20) + '...');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "GET /api/user (authenticated)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/user"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var token = pm.environment.get('token');",
                  "if (!token || token === '') {",
                  "  console.warn('⚠️  WARNING: Token is empty. Run \"Login (sets token)\" request first.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/users",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/users"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var token = pm.environment.get('token');",
                  "if (!token || token === '') {",
                  "  throw new Error('❌ Token is empty! Run \"Login (sets token)\" request first to authenticate.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/users/1",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/users/1"
          }
        }
      ]
    },
    {
      "name": "Leagues",
      "item": [
        {
          "name": "GET /api/leagues",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/leagues"
          }
        },
        {
          "name": "GET /api/leagues/1/seasons",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/leagues/1/seasons"
          }
        }
      ]
    },
    {
      "name": "Seasons",
      "item": [
        {
          "name": "GET /api/seasons/1",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/seasons/1"
          }
        },
        {
          "name": "GET /api/seasons/1/teams",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/seasons/1/teams"
          }
        },
        {
          "name": "GET /api/seasons/1/games",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/seasons/1/games"
          }
        },
        {
          "name": "GET /api/seasons/1/standings",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/seasons/1/standings"
          }
        },
        {
          "name": "GET /api/seasons/1/leaderboard",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/seasons/1/leaderboard"
          }
        }
      ]
    },
    {
      "name": "Teams",
      "item": [
        {
          "name": "GET /api/teams",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/teams"
          }
        },
        {
          "name": "POST /api/teams",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/teams",
            "body": {"mode": "raw", "raw": "{\"season_id\": 1, \"name\": \"Team Test\", \"coach\": \"Coach Test\"}"}
          }
        }
      ]
    },
    {
      "name": "Players",
      "item": [
        {
          "name": "GET /api/players",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/players"
          }
        }
      ]
    },
    {
      "name": "Games",
      "item": [
        {
          "name": "POST /api/games",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/games",
            "body": {"mode": "raw", "raw": "{\"season_id\": 1, \"home_team_id\": 1, \"away_team_id\": 2, \"scheduled_at\": \"2026-06-01T10:00:00Z\", \"venue\": \"Main Court\"}"}
          }
        },
        {
          "name": "POST /api/games/1/result",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{baseUrl}}/api/games/1/result",
            "body": {"mode": "raw", "raw": "{\"home_score\": 80, \"away_score\": 72}"}
          }
        }
      ]
    }
  ]
}
